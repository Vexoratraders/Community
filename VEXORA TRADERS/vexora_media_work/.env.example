# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
VEXORA_SECRET_KEY=replace-with-a-long-random-secret-at-least-32-characters
VEXORA_DATABASE_URL=sqlite:///./vexora.db
# For Docker Compose production, set VEXORA_POSTGRES_PASSWORD and use the PostgreSQL URL documented in README.md.
VEXORA_POSTGRES_USER=vexora
VEXORA_POSTGRES_PASSWORD=replace-with-a-long-random-database-password
VEXORA_POSTGRES_DB=vexora
VEXORA_COOKIE_SECURE=true
VEXORA_ENV=production
VEXORA_DEV_EMAIL_MODE=false
# Required in production for email verification and password-reset codes (STARTTLS, commonly port 587)
VEXORA_SMTP_HOST=
VEXORA_SMTP_PORT=587
VEXORA_SMTP_USER=
VEXORA_SMTP_PASSWORD=
VEXORA_EMAIL_FROM=no-reply@your-verified-domain.example

# Cloudflare Turnstile bot protection (register your site at dash.cloudflare.com)
VEXORA_TURNSTILE_SITE_KEY=your-public-turnstile-site-key
VEXORA_TURNSTILE_SECRET_KEY=your-private-turnstile-secret-key

# Set these to the individually verified account emails for privileged leadership. Never use a shared password as a role trigger.
VEXORA_PRESIDENT_EMAIL=vexoratraderscommunity@gmail.com
VEXORA_CEO_EMAIL=ceo-verified-email@example.com

# Comma-separated emails/usernames permitted to publish Trading Analysis
VEXORA_TRADE_ADMINS=owner@example.com

# Optional Redis for shared WebSocket broadcasts across multiple app instances
VEXORA_REDIS_URL=
# Exact public origin, including https://, required for passkeys behind a reverse proxy
# Set this to your exact public HTTPS origin when enabling passkeys, e.g. https://app.example.com
VEXORA_PUBLIC_ORIGIN=

# Optional AI-powered VEXORA Admin (OpenAI-compatible chat completions endpoint)
# Leave the API key blank to use the built-in rule-based fallback.
VEXORA_AI_API_KEY=
VEXORA_AI_BASE_URL=https://api.openai.com/v1
VEXORA_AI_MODEL=gpt-4o-mini
